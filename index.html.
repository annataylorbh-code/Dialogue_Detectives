<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dialogue Detectives: The Case Files</title>
<style>
  :root{
    --board:#D9C4A3;
    --board-dark:#C2A878;
    --folder:#F4E4C1;
    --folder-dark:#E7D3A4;
    --brown:#8B5E3C;
    --ink:#27314A;
    --navy:#1D3461;
    --gold:#FFD23F;
    --coral:#FF6B6B;
    --teal:#3E92CC;
    --green:#06D6A0;
    --purple:#9B5DE5;
    --amber:#E8A33D;
    --white:#FFFFFF;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Trebuchet MS','Segoe UI',Verdana,sans-serif;
    background:
      radial-gradient(circle at 20% 20%, rgba(255,255,255,0.10), transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(0,0,0,0.08), transparent 45%),
      linear-gradient(180deg, var(--board) 0%, var(--board-dark) 100%);
    color:var(--ink);
    min-height:100vh;
    padding:18px;
  }
  .wrap{max-width:1180px;margin:0 auto;}
  header{text-align:center;margin-bottom:10px;}
  h1{
    font-size:clamp(24px,4vw,38px);
    color:var(--navy);
    margin:4px 0 2px;
    text-shadow:2px 2px 0 rgba(255,255,255,0.5);
  }
  .subtitle{color:var(--navy);opacity:.8;font-size:15px;margin:0;}

  .progress-bar{
    max-width:520px;
    margin:14px auto 20px;
    background:rgba(255,255,255,0.55);
    border:2px solid var(--brown);
    border-radius:20px;
    padding:8px 16px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    font-weight:bold;
    font-size:14px;
    color:var(--navy);
  }
  .progress-track{
    flex:1;
    height:10px;
    background:rgba(255,255,255,0.7);
    border-radius:10px;
    overflow:hidden;
    border:1px solid var(--brown);
  }
  .progress-fill{
    height:100%;
    background:linear-gradient(90deg,var(--coral),var(--gold));
    width:0%;
    transition:width .4s ease;
  }

  .board{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(190px,1fr));
    gap:18px;
    background:rgba(255,255,255,0.18);
    border:3px dashed rgba(139,94,60,0.45);
    border-radius:24px;
    padding:24px;
  }
  .case-card{
    position:relative;
    background:var(--folder);
    border:3px solid var(--brown);
    border-radius:10px 10px 14px 14px;
    padding:16px 14px 14px;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease;
    box-shadow:0 6px 0 rgba(139,94,60,0.35), 0 8px 14px rgba(0,0,0,0.15);
    min-height:118px;
  }
  .case-card::before{
    content:"";
    position:absolute;
    top:-14px; left:16px;
    width:56px; height:16px;
    background:var(--skill-color, var(--teal));
    border:3px solid var(--brown);
    border-bottom:none;
    border-radius:6px 6px 0 0;
  }
  .case-card:hover:not(.locked){transform:translateY(-4px);box-shadow:0 10px 0 rgba(139,94,60,0.35), 0 14px 18px rgba(0,0,0,0.18);}
  .case-card.locked{cursor:not-allowed;opacity:.62;filter:grayscale(35%);}
  .case-card.solved{background:var(--folder-dark);}
  .case-num{
    display:inline-flex;align-items:center;justify-content:center;
    width:28px;height:28px;border-radius:50%;
    background:var(--navy);color:#fff;font-weight:bold;font-size:13px;
    margin-bottom:8px;
  }
  .case-title{font-weight:bold;font-size:14.5px;color:var(--navy);line-height:1.25;}
  .case-status{
    position:absolute;top:10px;right:12px;font-size:18px;
  }
  .case-skill-tag{
    margin-top:8px;font-size:10.5px;font-weight:bold;color:var(--ink);
    opacity:.75;
  }

  footer{text-align:center;font-size:11.5px;color:var(--navy);opacity:.6;margin-top:18px;}

  /* ---------- MODALS ---------- */
  .modal-overlay{
    position:fixed;inset:0;
    background:rgba(29,20,10,0.6);
    display:flex;align-items:center;justify-content:center;
    z-index:50;
    padding:16px;
    overflow-y:auto;
  }
  .hidden{display:none !important;}
  .modal-card{
    background:#fff;
    border-radius:22px;
    max-width:600px;
    width:100%;
    padding:22px;
    box-shadow:0 20px 50px rgba(0,0,0,.35);
    animation:pop .25s ease;
    margin:auto;
  }
  @keyframes pop{from{transform:scale(.9);opacity:0;}to{transform:scale(1);opacity:1;}}

  .intro-card{max-width:540px;text-align:center;}
  .intro-card ul{text-align:left;font-size:13.5px;line-height:1.65;color:var(--ink);}
  .modal-emoji{font-size:44px;text-align:center;}
  .modal-title{color:var(--navy);font-size:20px;font-weight:bold;margin:6px 0 4px;text-align:center;}

  .skill-chip{
    display:inline-block;
    background:var(--skill-color, var(--teal));
    color:#fff;
    padding:5px 14px;
    border-radius:20px;
    font-weight:bold;
    font-size:12.5px;
    margin-bottom:10px;
  }
  .case-header{text-align:center;}
  .case-illustration{
    display:block;
    max-width:220px;
    max-height:220px;
    margin:4px auto 12px;
  }
  .case-story{
    background:#FBF6EA;
    border:2px solid #EADFC3;
    border-radius:14px;
    padding:14px 16px;
    font-size:14.5px;
    line-height:1.55;
    color:var(--ink);
    margin-bottom:14px;
  }
  .case-question{
    font-size:16px;
    font-weight:bold;
    color:var(--navy);
    margin-bottom:12px;
    text-align:center;
  }
  .options-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:10px;
    margin-bottom:12px;
  }
  .opt-btn{
    background:#F4E4C1;
    border:2px solid #D8C398;
    border-radius:12px;
    padding:11px 14px;
    font-size:14px;
    font-weight:bold;
    color:var(--navy);
    cursor:pointer;
    text-align:left;
    transition:transform .1s;
  }
  .opt-btn:hover{transform:translateY(-2px);}
  .opt-btn.correct{background:#CFF6DE;border-color:var(--green);}
  .opt-btn.wrong{background:#FFD9D9;border-color:var(--coral);}
  .opt-btn:disabled{cursor:default;}

  .feedback{
    font-size:13.5px;
    font-weight:bold;
    margin-bottom:10px;
    padding:10px 12px;
    border-radius:10px;
    display:none;
  }
  .feedback.show{display:block;}
  .feedback.good{background:#E4F9EE;color:#0a8f5b;}
  .feedback.bad{background:#FDEAEA;color:#c94040;}

  .clue-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
  .clue-tag{
    font-size:11px;font-weight:bold;color:#fff;
    padding:3px 9px;border-radius:14px;
  }
  .clue-words{background:var(--teal);}
  .clue-voice{background:var(--purple);}
  .clue-actions{background:var(--green);}
  .clue-body{background:var(--coral);}
  .clue-fact{background:var(--navy);}
  .clue-opinion{background:var(--amber);}

  .modal-actions{text-align:center;}
  .continue-btn{
    background:var(--navy);color:#fff;border:none;padding:11px 30px;
    border-radius:24px;font-weight:bold;font-size:14.5px;cursor:pointer;
    box-shadow:0 5px 0 #10203f;
  }
  .continue-btn:active{transform:translateY(3px);box-shadow:none;}
  .continue-btn.hidden{display:none;}

  #startBtn, #playAgainBtn{
    background:var(--coral);color:#fff;border:none;padding:12px 30px;
    border-radius:26px;font-weight:bold;font-size:15px;cursor:pointer;
    box-shadow:0 6px 0 #d94f4f;margin-top:6px;
  }
  #startBtn:active, #playAgainBtn:active{transform:translateY(3px);box-shadow:none;}

  .win-modal .modal-emoji{font-size:60px;}
  .rank-badge{
    display:block;margin:6px auto 14px;
    max-width:160px;
  }
  .score-line{
    text-align:center;font-size:15px;font-weight:bold;color:var(--navy);margin-bottom:6px;
  }

  #confettiCanvas{
    position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:60;
  }
</style>
</head>
<body>

<div class="wrap">
  <header>
    <h1>🔍 Dialogue Detectives</h1>
    <p class="subtitle">Case Files: reading a character's words, voice, and actions as evidence</p>
  </header>

  <div class="progress-bar">
    <span id="progressLabel">Cases Solved: 0 / 10</span>
    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
  </div>

  <div class="board" id="board"></div>

  <footer>Made for 3rd grade detectives &middot; Character evidence &middot; Fact vs. opinion &middot; Assumptions &middot; Feelings &middot; Body language</footer>
</div>

<!-- INTRO -->
<div class="modal-overlay" id="introOverlay">
  <div class="modal-card intro-card">
    <div class="modal-emoji">🕵️</div>
    <div class="modal-title">Welcome, Detective!</div>
    <p style="font-size:14px;line-height:1.6;">Every case on this board is a short story with a mystery: <b>how does the character really feel, and how do we know?</b> Great detectives use EVIDENCE — a character's <b>words</b>, <b>voice</b>, and <b>actions</b> — to solve each case.</p>
    <ul>
      <li>🗂️ Click an unlocked case folder to open it.</li>
      <li>🔎 Read the story, look at the picture, and pick the best answer.</li>
      <li>⚖️ Some cases ask you to spot a <b>FACT</b> vs. an <b>OPINION</b> or <b>ASSUMPTION</b>.</li>
      <li>✅ Solve a case to unlock the next one on the board!</li>
    </ul>
    <div style="text-align:center;">
      <button id="startBtn">Start Investigating 🔍</button>
    </div>
  </div>
</div>

<!-- CASE MODAL -->
<div class="modal-overlay hidden" id="caseOverlay">
  <div class="modal-card">
    <div class="case-header">
      <span class="skill-chip" id="caseSkillChip">Skill</span>
      <div class="modal-title" id="caseTitle">Case Title</div>
      <img class="case-illustration" id="caseImg" src="" alt="Case illustration">
    </div>
    <div class="case-story" id="caseStory"></div>
    <div class="case-question" id="caseQuestion"></div>
    <div class="options-grid" id="optionsGrid"></div>
    <div class="feedback" id="feedback"></div>
    <div class="modal-actions">
      <button class="continue-btn hidden" id="continueBtn">Solve Case ✅</button>
    </div>
  </div>
</div>

<!-- COMPLETION MODAL -->
<div class="modal-overlay hidden" id="winOverlay">
  <div class="modal-card win-modal">
    <div class="modal-emoji">🎉</div>
    <div class="modal-title">All Cases Closed!</div>
    <img class="rank-badge" id="rankBadge" src="" alt="Detective badge">
    <div class="score-line" id="rankTitle">Rank: Junior Detective</div>
    <p style="text-align:center;font-size:14px;" id="scoreLine">You solved 0 out of 10 cases correctly on the first try.</p>
    <div style="text-align:center;">
      <button id="playAgainBtn">Play Again 🔄</button>
    </div>
  </div>
</div>

<canvas id="confettiCanvas"></canvas>

<script>
(function(){
  "use strict";

  /* ================= IMAGES (base64, injected at build time) ================= */
  const IMAGES = {"case1": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 78722 chars]...", "case2": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 46614 chars]...", "case3": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 51410 chars]...", "case4": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 75258 chars]...", "case5": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 52850 chars]...", "case6": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 57666 chars]...", "case7": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 60078 chars]...", "case8": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 50986 chars]...", "case9": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 72446 chars]...", "case10": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 93678 chars]...", "title": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 101550 chars]...", "completion": "data:image/png;base64,iVBORw0K...[BASE64 IMAGE DATA OMITTED, 81954 chars]..."};

  /* ================= SKILL META ================= */
  const SKILLS = {
    feelings:   { label:"🔍 Feelings Detective",   color:"#FF6B6B" },
    factopinion:{ label:"⚖️ Fact or Opinion",       color:"#3E92CC" },
    assumption: { label:"💭 Assumption Alert",      color:"#9B5DE5" },
    evidence:   { label:"🗣️ Evidence Finder",       color:"#06D6A0" },
    voice:      { label:"👂 Listen to the Voice",   color:"#E8A33D" },
    body:       { label:"👀 Silent Clues",          color:"#1D3461" },
    finale:     { label:"🏅 Detective Finale",      color:"#FFD23F" }
  };

  /* ================= CASE DATA ================= */
  const CASES = [
    {
      id:1, title:"The Science Fair Surprise", skill:"feelings", img:"case1",
      story:'Sam stared at the blue ribbon in his hands. His mouth dropped open and his eyes went wide. "I actually won?!" he shouted, jumping up and down.',
      question:"How does Sam feel?",
      options:["Excited and surprised","Angry and annoyed","Bored and tired","Sad and disappointed"],
      correct:"Excited and surprised",
      clues:[["words","Words: “I actually won?!”"],["voice","Voice: he shouted"],["actions","Actions: jumping up and down"]],
      explain:"His words, his loud voice, and his jumping are all evidence pointing to excitement and surprise!"
    },
    {
      id:2, title:"The New Student", skill:"factopinion", img:"case2",
      story:'The new student, Leo, sat alone at lunch. He is wearing a blue backpack. Some kids said he seems shy, but nobody really knows for sure.',
      question:"Which sentence is a FACT — something we know for certain?",
      options:["Leo is wearing a blue backpack.","Leo seems shy.","Leo doesn't like anyone.","Leo is having a bad day."],
      correct:"Leo is wearing a blue backpack.",
      clues:[["fact","Fact: we can SEE the backpack"],["opinion","Opinion/guess: “seems shy”"]],
      explain:"We can see the blue backpack — that's a fact! “Seems shy” is what someone thinks, which is an opinion, not a fact."
    },
    {
      id:3, title:"The Quiet Hallway", skill:"assumption", img:"case3",
      story:"Maya walked past her friend Priya without saying hello. Priya's shoulders slumped, and she looked down at her shoes.",
      question:"Which of these is an ASSUMPTION — a guess that isn't proven?",
      options:["Maya is mad at Priya.","Maya walked past Priya.","Priya looked down at her shoes.","Priya's shoulders slumped."],
      correct:"Maya is mad at Priya.",
      clues:[["opinion","Assumption: we don't know WHY"],["fact","Fact: what the story actually says"]],
      explain:"We don't know WHY Maya didn't say hello — maybe she just didn't see Priya! Saying she's “mad” is a guess, not something the story tells us for sure."
    },
    {
      id:4, title:"Coach's Cheer", skill:"evidence", img:"case4",
      story:'Coach blew the whistle. "Great hustle out there, team!" she said with a huge smile, clapping her hands.',
      question:"Which is the BEST evidence that Coach is proud of the team?",
      options:["She said “Great hustle!” with a smile and clapped.","She blew the whistle.","The team ran onto the field.","It was practice time."],
      correct:"She said “Great hustle!” with a smile and clapped.",
      clues:[["words","Words: “Great hustle out there, team!”"],["voice","Voice: said with a huge smile"],["actions","Actions: clapping her hands"]],
      explain:"Her words, her smile, and her clapping all work together as strong evidence that she's proud."
    },
    {
      id:5, title:"Jordan's “Fine”", skill:"voice", img:"case5",
      story:'"Fine," Jordan mumbled, staring at the floor. "I said I\'m FINE," he snapped when his sister asked again.',
      question:"What does Jordan's VOICE tell you, even though his words say he's fine?",
      options:["He is actually upset about something.","He is happy and relaxed.","He is excited to talk.","He didn't hear his sister."],
      correct:"He is actually upset about something.",
      clues:[["words","Words: “Fine” / “I'm FINE”"],["voice","Voice: mumbled, then snapped"]],
      explain:"Jordan's words say “fine,” but the way he says it — mumbling, then snapping — doesn't match. His voice tells us he's really upset!"
    },
    {
      id:6, title:"The Diving Board", skill:"body", img:"case6",
      story:"Ben stood at the edge of the diving board. He wrapped his arms around himself and took a tiny step backward, chewing his lip.",
      question:"Without any words, what do Ben's actions tell us he's feeling?",
      options:["Nervous or scared","Excited and eager","Angry","Sleepy"],
      correct:"Nervous or scared",
      clues:[["body","Body language: arms wrapped around himself, stepping back, chewing his lip"]],
      explain:"Wrapping his arms around himself, stepping back, and chewing his lip are body language clues — even with no words, we can tell Ben feels nervous!"
    },
    {
      id:7, title:"Nibbles the Hamster", skill:"factopinion", img:"case7",
      story:'The classroom pet hamster, Nibbles, ran on his wheel all morning. "Nibbles is the cutest hamster in the whole school," said Ava.',
      question:"Which sentence is an OPINION — what someone thinks or feels, not a fact?",
      options:["Nibbles is the cutest hamster in the whole school.","Nibbles ran on his wheel.","Nibbles is a hamster.","It was morning."],
      correct:"Nibbles is the cutest hamster in the whole school.",
      clues:[["opinion","Opinion: “cutest” is what Ava thinks"],["fact","Fact: the other sentences can be checked"]],
      explain:"“Cutest” is Ava's opinion — other people might think differently! The other sentences are facts anyone could check."
    },
    {
      id:8, title:"Grandpa's Garden", skill:"assumption", img:"case8",
      story:"Every day this week, Grandpa has stayed inside instead of working in his garden like usual.",
      question:"Which of these is an ASSUMPTION about Grandpa?",
      options:["Grandpa must not be feeling well.","Grandpa stayed inside.","It is this week.","Grandpa has a garden."],
      correct:"Grandpa must not be feeling well.",
      clues:[["opinion","Assumption: we don't know FOR SURE why"],["fact","Fact: what the story actually says"]],
      explain:"We don't know for sure WHY Grandpa stayed inside — maybe it rained, maybe he's busy! Guessing he's sick is an assumption, not a fact from the story."
    },
    {
      id:9, title:"Big News!", skill:"evidence", img:"case9",
      story:'Zoe burst through the door and threw her arms around her mom. "I made the team! I made the team!" she squealed. It was three o\'clock in the afternoon.',
      question:"Which detail is NOT evidence of how Zoe feels?",
      options:["It was three o'clock in the afternoon.","She threw her arms around her mom.","She squealed “I made the team!”","She burst through the door."],
      correct:"It was three o'clock in the afternoon.",
      clues:[["actions","Actions: bursting in, hugging her mom"],["voice","Voice: squealed"],["fact","Just a fact, not a feeling clue: the time of day"]],
      explain:"The time of day doesn't tell us anything about Zoe's feelings. But bursting in, hugging her mom, and squealing are all strong clues that she's thrilled!"
    },
    {
      id:10, title:"The Kind Teacher", skill:"finale", img:"case10",
      story:'Ms. Patel placed a stack of graded tests on Carlos\'s desk. Carlos\'s shoulders drooped, and he quickly slid the paper into his backpack without looking at it. "It\'s okay," Ms. Patel said gently, kneeling beside his desk. "Everyone struggles with something new. Let\'s figure this out together," she said with a warm smile.',
      question:"Which is the BEST evidence that Ms. Patel wants to HELP Carlos, not just give him a grade?",
      options:["She knelt down, smiled, and said “Let's figure this out together.”","She placed the tests on the desk.","Carlos slid the paper into his backpack.","Carlos's shoulders drooped."],
      correct:"She knelt down, smiled, and said “Let's figure this out together.”",
      clues:[["actions","Actions: kneeling beside his desk"],["voice","Voice: said gently, with a warm smile"],["words","Words: “Let's figure this out together.”"]],
      explain:"Kneeling to his level, her gentle voice, her smile, and her words all show she cares and wants to help — not just hand back a grade."
    }
  ];

  /* ================= STATE ================= */
  let unlockedCount = 1;
  let solved = {};       // id -> true
  let correctFirst = {}; // id -> true if correct on first try
  let audioCtx = null;
  let activeCase = null;

  /* ================= AUDIO ================= */
  function ensureAudio(){
    if(!audioCtx){
      try{ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ audioCtx = null; }
    }
    if(audioCtx && audioCtx.state === 'suspended'){ audioCtx.resume(); }
  }
  function tone(freq, start, duration, type, vol){
    if(!audioCtx) return;
    type = type || 'sine'; vol = vol===undefined?0.18:vol;
    const t0 = audioCtx.currentTime + start;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0.0001, t0);
    gain.gain.linearRampToValueAtTime(vol, t0+0.012);
    gain.gain.exponentialRampToValueAtTime(0.0001, t0+duration);
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t0); osc.stop(t0+duration+0.03);
  }
  const sfx = {
    click(){ tone(700,0,0.05,'square',0.08); },
    open(){ tone(380,0,0.05,'square',0.10); tone(520,0.05,0.07,'square',0.10); },
    correct(){ [523.25,659.25,783.99,1046.5].forEach((f,i)=>tone(f,i*0.09,0.18,'sine',0.17)); },
    wrong(){ tone(220,0,0.22,'sawtooth',0.13); tone(160,0.10,0.28,'sawtooth',0.11); },
    unlock(){ [660,880].forEach((f,i)=>tone(f,i*0.09,0.14,'triangle',0.15)); },
    fanfare(){ [523.25,523.25,523.25,659.25,783.99,1046.5].forEach((f,i)=>tone(f,i*0.16,0.32,'triangle',0.19)); },
    welcome(){ [440,554,659].forEach((f,i)=>tone(f,i*0.1,0.2,'sine',0.15)); }
  };

  /* ================= HELPERS ================= */
  function shuffle(arr){
    const a = arr.slice();
    for(let i=a.length-1;i>0;i--){
      const j = Math.floor(Math.random()*(i+1));
      [a[i],a[j]] = [a[j],a[i]];
    }
    return a;
  }
  function clueTagHtml(pair){
    const cls = pair[0], text = pair[1];
    return '<span class="clue-tag clue-'+cls+'">'+text+'</span>';
  }

  /* ================= BOARD RENDER ================= */
  function buildBoard(){
    const board = document.getElementById('board');
    board.innerHTML = '';
    CASES.forEach((c, idx)=>{
      const num = idx+1;
      const locked = num > unlockedCount;
      const isSolved = !!solved[c.id];
      const card = document.createElement('div');
      card.className = 'case-card' + (locked ? ' locked' : '') + (isSolved ? ' solved' : '');
      card.style.setProperty('--skill-color', SKILLS[c.skill].color);
      card.innerHTML =
        '<div class="case-status">'+(locked ? '🔒' : (isSolved ? '✅' : '📂'))+'</div>'+
        '<div class="case-num">'+num+'</div>'+
        '<div class="case-title">'+c.title+'</div>'+
        '<div class="case-skill-tag">'+SKILLS[c.skill].label+'</div>';
      if(!locked){
        card.addEventListener('click', ()=> openCase(c));
      }
      board.appendChild(card);
    });
    updateProgress();
  }

  function updateProgress(){
    const count = Object.keys(solved).length;
    document.getElementById('progressLabel').textContent = 'Cases Solved: '+count+' / '+CASES.length;
    document.getElementById('progressFill').style.width = (count/CASES.length*100)+'%';
  }

  /* ================= CASE MODAL ================= */
  function openCase(c){
    activeCase = c;
    ensureAudio();
    sfx.open();
    const overlay = document.getElementById('caseOverlay');
    const chip = document.getElementById('caseSkillChip');
    chip.textContent = SKILLS[c.skill].label;
    chip.style.setProperty('--skill-color', SKILLS[c.skill].color);
    chip.style.background = SKILLS[c.skill].color;
    document.getElementById('caseTitle').textContent = 'Case '+c.id+': '+c.title;
    document.getElementById('caseImg').src = IMAGES[c.img];
    document.getElementById('caseStory').textContent = c.story;
    document.getElementById('caseQuestion').textContent = c.question;

    const grid = document.getElementById('optionsGrid');
    grid.innerHTML = '';
    const feedback = document.getElementById('feedback');
    feedback.className = 'feedback';
    feedback.innerHTML = '';
    const continueBtn = document.getElementById('continueBtn');
    continueBtn.classList.add('hidden');
    continueBtn.textContent = 'Solve Case ✅';

    const alreadySolved = !!solved[c.id];
    const opts = shuffle(c.options);

    function renderFeedback(wasCorrect){
      feedback.classList.add('show', wasCorrect ? 'good' : 'bad');
      const clueHtml = c.clues.map(clueTagHtml).join('');
      feedback.innerHTML = (wasCorrect ? '🌟 Yes! ' : 'Not quite — ') + c.explain +
        '<div class="clue-tags">'+clueHtml+'</div>';
    }

    if(alreadySolved){
      // Review mode: show correct answer highlighted, no scoring changes
      opts.forEach(optText=>{
        const btn = document.createElement('button');
        btn.className = 'opt-btn';
        btn.textContent = optText;
        btn.disabled = true;
        if(optText === c.correct){ btn.classList.add('correct'); }
        grid.appendChild(btn);
      });
      renderFeedback(true);
      continueBtn.textContent = 'Close';
      continueBtn.classList.remove('hidden');
    } else {
      let answered = false;
      opts.forEach(optText=>{
        const btn = document.createElement('button');
        btn.className = 'opt-btn';
        btn.textContent = optText;
        btn.addEventListener('click', ()=>{
          if(answered) return;
          answered = true;
          ensureAudio();
          const wasCorrect = (optText === c.correct);
          const buttons = grid.querySelectorAll('.opt-btn');
          buttons.forEach(b=>{
            b.disabled = true;
            if(b.textContent === c.correct){ b.classList.add('correct'); }
          });
          if(!wasCorrect){ btn.classList.add('wrong'); }
          if(wasCorrect){ sfx.correct(); correctFirst[c.id] = true; }
          else { sfx.wrong(); }
          renderFeedback(wasCorrect);
          continueBtn.classList.remove('hidden');
        });
        grid.appendChild(btn);
      });
    }

    overlay.classList.remove('hidden');

    const onContinue = ()=>{
      overlay.classList.add('hidden');
      continueBtn.removeEventListener('click', onContinue);
      if(!alreadySolved){
        solveCase(c);
      }
    };
    continueBtn.addEventListener('click', onContinue);
  }

  function solveCase(c){
    solved[c.id] = true;
    const idx = CASES.findIndex(x=>x.id===c.id);
    if(idx+2 > unlockedCount && idx+1 < CASES.length){
      unlockedCount = idx+2;
      sfx.unlock();
    }
    buildBoard();
    if(Object.keys(solved).length === CASES.length){
      setTimeout(showCompletion, 300);
    }
  }

  /* ================= COMPLETION ================= */
  function showCompletion(){
    const total = CASES.length;
    const correctCount = Object.keys(correctFirst).length;
    const pct = correctCount/total;
    let rank;
    if(pct >= 0.9) rank = "🏆 Master Dialogue Detective!";
    else if(pct >= 0.7) rank = "🕵️ Senior Detective";
    else if(pct >= 0.5) rank = "🔍 Junior Detective";
    else rank = "📋 Rookie Detective — keep practicing!";

    document.getElementById('rankBadge').src = IMAGES.completion;
    document.getElementById('rankTitle').textContent = rank;
    document.getElementById('scoreLine').textContent =
      'You solved '+correctCount+' out of '+total+' cases correctly on the first try.';
    document.getElementById('winOverlay').classList.remove('hidden');
    sfx.fanfare();
    launchConfetti();
  }

  /* ================= CONFETTI ================= */
  function launchConfetti(){
    const canvas = document.getElementById('confettiCanvas');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const ctx = canvas.getContext && canvas.getContext('2d');
    if(!ctx) return;
    const colors = ['#FF6B6B','#3E92CC','#06D6A0','#FFD23F','#9B5DE5'];
    const particles = [];
    for(let i=0;i<140;i++){
      particles.push({
        x: Math.random()*canvas.width,
        y: -20 - Math.random()*canvas.height*0.5,
        w: 6+Math.random()*6,
        h: 8+Math.random()*8,
        color: colors[Math.floor(Math.random()*colors.length)],
        speed: 2+Math.random()*3,
        drift: -1+Math.random()*2,
        rot: Math.random()*360,
        rotSpeed: -6+Math.random()*12
      });
    }
    let frames = 0;
    const maxFrames = 260;
    function draw(){
      ctx.clearRect(0,0,canvas.width,canvas.height);
      particles.forEach(pt=>{
        pt.y += pt.speed;
        pt.x += pt.drift;
        pt.rot += pt.rotSpeed;
        ctx.save();
        ctx.translate(pt.x, pt.y);
        ctx.rotate(pt.rot*Math.PI/180);
        ctx.fillStyle = pt.color;
        ctx.fillRect(-pt.w/2,-pt.h/2,pt.w,pt.h);
        ctx.restore();
      });
      frames++;
      if(frames < maxFrames){ requestAnimationFrame(draw); }
      else { ctx.clearRect(0,0,canvas.width,canvas.height); }
    }
    draw();
  }
  window.addEventListener('resize', ()=>{
    const canvas = document.getElementById('confettiCanvas');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  });

  /* ================= SETUP / RESET ================= */
  function startGame(){
    unlockedCount = 1;
    solved = {};
    correctFirst = {};
    buildBoard();
  }

  document.getElementById('startBtn').addEventListener('click', ()=>{
    ensureAudio();
    sfx.welcome();
    document.getElementById('introOverlay').classList.add('hidden');
    startGame();
  });
  document.getElementById('playAgainBtn').addEventListener('click', ()=>{
    document.getElementById('winOverlay').classList.add('hidden');
    startGame();
  });

  buildBoard();
})();
</script>
